{
  "private": true,
  "workspaces": {
    "packages": [
      "contracts",
      "client",
      "deps/hljs"
    ]
  },
  "dependencies": {
    "highlight.js": "^10.7.2",
    "react-loader-spinner": "^5.3.4"
  },
  "resolutions": {
    "**/highlight.js": "10.7.2-local"
  },
  "scripts": {
    "test": "cd contracts && forge test",
    "compile:contracts": "cd contracts && forge build",
    "deploy:contracts": "cd contracts && forge script script/Deploy.s.sol --broadcast --rpc-url ${RPC_URL:-http://127.0.0.1:8545}",
    "upgrade:proxy": "cd contracts && forge script script/Upgrade.s.sol --broadcast --rpc-url ${RPC_URL:-http://127.0.0.1:8545}",
    "network": "anvil --chain-id 1337",
    "build:game": "yarn compile:contracts && yarn --cwd client build",
    "start:game": "cd client && yarn start",
    "test:contracts": "cd contracts && forge test",
    "leaderboard:oldCrawler": "node client/leaderboard/scripts/crawlers/crawlHistoricalData/index.cjs",
    "leaderboard:newCrawler": "node client/leaderboard/scripts/crawlers/crawlNewData/index.cjs",
    "leaderboard:triggerNextCrawl": "node client/leaderboard/scripts/actuate/index.cjs"
  }
}
